# 复制为 .env 并按需修改；docker compose 会自动读取同目录 .env

# ===== 持久化 =====
# 空 = 纯内存模式（重启丢记忆）；填路径 = SQLite 持久化
DB_PATH=/app/data/agent.db

# ===== LLM（当前用 mock，微调完成后切换 qwen）=====
LLM_BACKEND=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=qwen2.5-7b-instruct

# ===== 语音（mock = 占位；edge = 真实合成，免费）=====
TTS_BACKEND=edge
AUDIO_DIR=/app/static/audio

# ===== 鉴权（空 = 关闭；生产环境务必设置强随机值）=====
API_TOKEN=change-me-to-a-long-random-string
